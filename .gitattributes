# Auto detect text files and perform LF normalization
* text=auto


# Enforce LF for source code
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# Keep CRLF for Windows batch scripts
*.bat    text eol=crlf

# Treat these as binary (no diff)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
